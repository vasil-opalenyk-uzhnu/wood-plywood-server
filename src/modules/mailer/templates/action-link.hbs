<p style="margin:0 0 20px;font-size:15px;line-height:1.6;">
  {{intro}}
</p>

<table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin:0 auto 20px;">
  <tr>
    <td align="center" style="background:#8B5E3C;border-radius:10px;">
      <a href="{{link}}"
         style="display:inline-block;padding:14px 32px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#FBF9F4;text-decoration:none;">
        {{buttonLabel}}
      </a>
    </td>
  </tr>
</table>

<p style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#8A8478;">
  The link is valid for {{ttl}}. If the button does not work, copy this link into your browser:
</p>
<p style="margin:0 0 {{#if note}}12px{{else}}0{{/if}};font-size:12px;line-height:1.5;color:#8B5E3C;word-break:break-all;">
  {{link}}
</p>
{{#if note}}
<p style="margin:0;font-size:13px;line-height:1.5;color:#8A8478;">
  {{note}}
</p>
{{/if}}
